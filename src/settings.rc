#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "settings_resource.h"
LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED
IDD_SETTINGS DIALOGEX 0, 0, 440, 388
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "隐私拼音 · 设置"
FONT 10, "Microsoft YaHei UI"
BEGIN
    LTEXT "默认保存在本机；云同步需手动开启。", -1, 16, 12, 286, 16
    RTEXT "", IDC_VERSION, 308, 12, 116, 16
    GROUPBOX "中文输入统计", -1, 16, 33, 408, 63
    LTEXT "", IDC_STATISTICS_TOTAL, 28, 49, 190, 16
    LTEXT "", IDC_STATISTICS_TODAY, 224, 49, 188, 16
    LTEXT "", IDC_STATISTICS_SPEED, 28, 70, 384, 18
    LTEXT "", IDC_PERSONAL_SUMMARY, 16, 106, 408, 38
    CONTROL "", IDC_STATISTICS_TABS, "SysTabControl32", WS_TABSTOP, 16, 149, 408, 126
    CONTROL "", IDC_DAILY_STATISTICS, "SysListView32", WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS, 22, 172, 396, 97
    CONTROL "个人词库每日新增词汇增长曲线", IDC_GROWTH_CHART, "Static", SS_OWNERDRAW, 22, 172, 396, 97
    LTEXT "仅计确认上屏的汉字；速度按有效输入时间计算，排除 30 秒及以上停顿。", IDC_STATISTICS_RULE, 16, 284, 408, 24
    LTEXT "", IDC_STATISTICS_STATUS, 16, 307, 408, 15
    PUSHBUTTON "个性化设置…", IDC_PERSONALIZATION_OPEN, 16, 330, 86, 18
    LTEXT "状态图标轮换与自定义图标", -1, 110, 332, 314, 16
    PUSHBUTTON "导出个人词库…", IDC_EXPORT_PERSONAL, 16, 363, 86, 18
    PUSHBUTTON "合并词库…", IDC_MERGE_DICTIONARY, 108, 363, 66, 18
    PUSHBUTTON "打开词库目录", IDC_OPEN_DIRECTORY, 180, 363, 80, 18
    PUSHBUTTON "云同步…", IDC_SYNC_OPEN, 266, 363, 62, 18
    PUSHBUTTON "刷新", IDC_REFRESH_STATISTICS, 334, 363, 42, 18
    DEFPUSHBUTTON "关闭", IDOK, 382, 363, 42, 18
END

IDD_PERSONALIZATION DIALOGEX 0, 0, 400, 156
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "隐私拼音 · 个性化设置"
FONT 10, "Microsoft YaHei UI"
BEGIN
    CONTROL "切回输入法时自动轮换图标", IDC_ROTATE_ICONS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 16, 368, 16
    LTEXT "默认关闭；开启后按文件名依次轮换左侧状态图标。", -1, 16, 40, 368, 16
    LTEXT "保留 P 标识；鼠标悬停可查看当前中英文状态。", -1, 16, 61, 368, 16
    PUSHBUTTON "打开图标目录", IDC_OPEN_ICONS, 16, 86, 100, 20
    LTEXT "添加透明背景的 .ico 文件，下次切回时生效。", -1, 124, 88, 260, 26
    DEFPUSHBUTTON "关闭", IDOK, 324, 126, 60, 18
END

IDD_SYNC_SETTINGS DIALOGEX 0, 0, 440, 190
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "隐私拼音 · 个人词库云同步"
FONT 10, "Microsoft YaHei UI"
BEGIN
    CONTROL "启用双向同步（每 10 分钟）", IDC_SYNC_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 14, 260, 14
    PUSHBUTTON "立即同步", IDC_SYNC_NOW, 332, 12, 92, 18
    LTEXT "地址", -1, 16, 41, 28, 14
    EDITTEXT IDC_SYNC_URL, 50, 38, 374, 18, ES_AUTOHSCROLL
    LTEXT "令牌", -1, 16, 65, 28, 14
    EDITTEXT IDC_SYNC_TOKEN, 50, 62, 274, 18, ES_AUTOHSCROLL | ES_PASSWORD
    PUSHBUTTON "保存同步设置", IDC_SYNC_SAVE, 332, 62, 92, 18
    LTEXT "", IDC_SYNC_STATUS, 16, 92, 408, 30
    LTEXT "", IDC_SYNC_SUCCESS, 16, 125, 408, 14
    LTEXT "其他设备填写相同地址和令牌；关闭此窗口后继续后台同步。", -1, 16, 145, 408, 14
    DEFPUSHBUTTON "关闭", IDOK, 364, 165, 60, 18
END
